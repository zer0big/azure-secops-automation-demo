{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "logicapp-apim-aoai-monitoring"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "lawWorkspaceId": "<your-law-workspace-id>",
    "subscriptionId": "[subscription().subscriptionId]",
    "resourceGroupName": "[resourceGroup().name]",
    "apimName": "zbho-dw9-apim",
    "teamsChannelId": "19:32df97df94214adfa36ab24db8a1a9dc@thread.tacv2",
    "teamsGroupId": "<your-teams-group-id>",
    "emailTo": "azure-mvp@zerobig.kr",
    "teamsConnectionId": "[resourceId('Microsoft.Web/connections', 'teams')]",
    "outlookConnectionId": "[resourceId('Microsoft.Web/connections', 'outlook')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "teams",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Teams",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "outlook",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Outlook",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', 'teams')]",
        "[resourceId('Microsoft.Web/connections', 'outlook')]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": ["7"],
                  "minutes": [0]
                },
                "timeZone": "Korea Standard Time"
              }
            },
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {}
              }
            }
          },
          "actions": {
            "Query_APIM_Errors": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "[concat('https://api.loganalytics.io/v1/workspaces/', variables('lawWorkspaceId'), '/query')]",
                "headers": {
                  "Content-Type": "application/json"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://api.loganalytics.io"
                },
                "body": {
                  "query": "ApiManagementGatewayLogs | where TimeGenerated > ago(24h) | where ResponseCode >= 400 | extend KST = TimeGenerated + 9h | extend Category = case(ResponseCode >= 500, 'Server Error', ResponseCode == 404, 'Not Found', ResponseCode == 401 or ResponseCode == 403, 'Auth Error', ResponseCode == 429, 'Rate Limit', 'Client Error') | summarize ErrorCount = count() by Category, ResponseCode | order by ErrorCount desc"
                }
              }
            },
            "Parse_Query_Result": {
              "type": "ParseJson",
              "runAfter": {
                "Query_APIM_Errors": ["Succeeded"]
              },
              "inputs": {
                "content": "@body('Query_APIM_Errors')",
                "schema": {
                  "type": "object",
                  "properties": {
                    "tables": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "rows": {
                            "type": "array"
                          },
                          "columns": {
                            "type": "array"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "Check_Errors_Exist": {
              "type": "If",
              "runAfter": {
                "Parse_Query_Result": ["Succeeded"]
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Parse_Query_Result')?['tables']?[0]?['rows'])",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Send_Email": {
                  "type": "ApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['outlook']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "[variables('emailTo')]",
                      "Subject": "[APIM Alert] @{formatDateTime(utcNow(), 'yyyy-MM-dd')} API 오류 감지",
                      "Body": "<html><body><h2>🚨 APIM 오류 알림</h2><p><strong>시간:</strong> @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')} UTC</p><p><strong>리소스:</strong> zbho-dw9-apim</p><h3>오류 요약</h3><p>최근 24시간 동안 API 오류가 감지되었습니다.</p><p>결과 행 수: @{length(body('Parse_Query_Result')?['tables']?[0]?['rows'])}</p><h3>🔗 바로가기</h3><ul><li><a href='https://portal.azure.com/#@/resource/subscriptions/<your-subscription-id>/resourceGroups/RG-ZBHO-DW9-APIM-AOAI-DEMO/providers/Microsoft.ApiManagement/service/zbho-dw9-apim/overview'>APIM 포털</a></li><li><a href='https://portal.azure.com/#blade/Microsoft_Azure_Monitoring_Logs/LogsBlade/resourceId/%2Fsubscriptions%2F<your-subscription-id>%2FresourceGroups%2FRG-ZBHO-DW9-APIM-AOAI-DEMO%2Fproviders%2FMicrosoft.OperationalInsights%2Fworkspaces%2Fzbho-dw9-law'>Log Analytics</a></li></ul></body></html>",
                      "Importance": "High",
                      "IsHtml": true
                    }
                  }
                },
                "Send_Teams_Message": {
                  "type": "ApiConnection",
                  "runAfter": {
                    "Send_Email": ["Succeeded"]
                  },
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['teams']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v3/beta/teams/<your-teams-group-id>/channels/19%3A32df97df94214adfa36ab24db8a1a9dc%40thread.tacv2/messages",
                    "body": {
                      "body": {
                        "contentType": "html",
                        "content": "<h2>🚨 APIM 오류 알림</h2><p><strong>시간:</strong> @{formatDateTime(utcNow(), 'yyyy-MM-dd HH:mm')} UTC</p><p><strong>오류 건수:</strong> @{length(body('Parse_Query_Result')?['tables']?[0]?['rows'])} 종류</p><p>📊 <a href='https://portal.azure.com/#blade/Microsoft_Azure_Monitoring_Logs/LogsBlade'>Log Analytics에서 확인</a></p>"
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Log_No_Errors": {
                    "type": "Compose",
                    "runAfter": {},
                    "inputs": {
                      "status": "OK",
                      "message": "No errors found in the last 24 hours",
                      "checkedAt": "@{utcNow()}"
                    }
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "teams": {
                "connectionId": "[variables('teamsConnectionId')]",
                "connectionName": "teams",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'teams')]"
              },
              "outlook": {
                "connectionId": "[variables('outlookConnectionId')]",
                "connectionName": "outlook",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
    }
  }
}
